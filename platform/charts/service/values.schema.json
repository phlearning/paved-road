{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "name",
    "image",
    "port"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z]([-a-z0-9]{0,38}[a-z0-9])?$",
      "description": "DNS-1123 label, at most 40 characters."
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "replicas": {
      "type": "integer",
      "minimum": 0
    },
    "port": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535
    },
    "env": {
      "type": "array"
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "host": {
          "type": "string"
        },
        "clusterIssuer": {
          "type": "string"
        }
      }
    },
    "postgres": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "instances": {
          "type": "integer",
          "minimum": 1
        },
        "storage": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z_][a-z0-9_]*$"
          }
        }
      }
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "args"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z]([-a-z0-9]{0,18}[a-z0-9])?$"
          },
          "args": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "pattern": "^[A-Z_][A-Z0-9_]*$"
      }
    },
    "dashboard": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "panels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "title",
              "expr"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "expr": {
                "type": "string"
              },
              "unit": {
                "type": "string"
              },
              "legend": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
